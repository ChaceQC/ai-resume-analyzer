# 必填：配置兼容 Chat Completions 的AI评分服务。
# 未配置或模型失败时不生成分数，不提供固定规则降级。
AI_API_KEY=
# 支持域名、基础路径或完整的 /chat/completions 地址。
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# 可选：后端使用 Clash 普通代理时填写；不需要代理则留空。
AI_PROXY=
# 可选：评分快照数据库，只存指纹、分值和版本，不存简历原文。
# SCORE_CACHE_PATH=data/scores.sqlite3
# 可选：替换行情快照，支持 JSON 或 JSON.GZ。
# MARKET_SNAPSHOT_PATH=market_data/snapshot.json.gz
HOST=127.0.0.1
PORT=5000
